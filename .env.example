# Copy this file to `.env` and fill in values.
#
# Notes:
# - The web app uses Redis for task/progress tracking.
# - The CLI can run without Redis.

# Redis (preferred)
REDIS_URL=redis://localhost:6379/0

# Alternative Redis env var used by Heroku Redis add-ons
# HEROKU_REDIS_OLIVE_URL=

# Session cookie secret (set a long random string in production)
SESSION_SECRET=change-me

# Database (accounts, profiles, API keys, report ownership/visibility).
# Heroku Postgres sets DATABASE_URL automatically (postgres://...); the app
# rewrites it to an async driver. Leave unset locally to use a SQLite file.
DATABASE_URL=
# TLS for managed Postgres: "" (auto: relaxed TLS for remote hosts), "disable", "require", or "verify".
DATABASE_SSL=

# OAuth sign-in (Phase 2). Leave unset to disable login locally.
# Google: https://console.cloud.google.com/apis/credentials (Web app OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ORCID: https://orcid.org/developer-tools (use sandbox for testing)
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# Use the ORCID sandbox (sandbox.orcid.org) instead of production.
ORCID_SANDBOX=
# Public base URL used to build OAuth redirect URIs, e.g. https://your-app.example.com
OAUTH_REDIRECT_BASE_URL=

# Anonymous (not signed-in) reports auto-delete after this many seconds (default 7 days).
ANONYMOUS_TASK_TTL_SECONDS=604800

# Logging
LOG_LEVEL=INFO

# LLM provider API keys (set at least one)
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
CLAUDE_API_KEY=

# Optional model overrides
OPENAI_MODEL=gpt-5
OPENAI_COMPARISON_MODEL=gpt-5
OPENAI_EXPERIMENT_MODEL=gpt-5
OPENAI_EXPERIMENT_REASONING_EFFORT=medium
GPT_OSS_MODEL=gpt-oss-120b
GROQ_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct
DEEPSEEK_MODEL=deepseek-reasoner
CLAUDE_MODEL=claude-opus-4-8
# Max output tokens for Claude (defaults: 16000 for comparison, 32000 for experiment isolation).
CLAUDE_MAX_TOKENS=

# Optional parser overrides
GROBID_URL=https://kermitt2-grobid.hf.space/api/processFulltextDocument
DPT_API_KEY=
DPT_URL=https://api.va.eu-west-1.landing.ai/v1/ade/parse
PDF_PARSER_FALLBACKS=dpt2,pymupdf
# Optional external structured-parser HTTP service — base URL of the service.
# Left unset by default (disabled); RegCheck only calls its HTTP API.
EXTERNAL_PARSER_URL=
EXTERNAL_PARSER_API_KEY=
EXTERNAL_PARSER_TIMEOUT_SECONDS=300

# Optional directories (defaults are repo-relative)
STATIC_DIR=static
TEMPLATES_DIR=templates
UPLOAD_DIR=uploads

# Optional: S3-backed upload handoff for multi-dyno deployments.
# Completed report evidence artifacts are stored in Redis, not S3.
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
